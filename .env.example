# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database (MySQL)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mubashars_book

# Email (configure for production)
